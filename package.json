{
  "name": "@mrgrain/cdk-updown",
  "description": "Self-executable CDK apps",
  "repository": {
    "type": "git",
    "url": "git@github.com:mrgrain/cdk-updown.git"
  },
  "scripts": {
    "biome": "projen biome",
    "build": "projen build",
    "bump": "projen bump",
    "bump:releasable-commits": "projen bump:releasable-commits",
    "clobber": "projen clobber",
    "compile": "projen compile",
    "default": "projen default",
    "eject": "projen eject",
    "logo": "projen logo",
    "package": "projen package",
    "post-compile": "projen post-compile",
    "post-upgrade": "projen post-upgrade",
    "pre-compile": "projen pre-compile",
    "release": "projen release",
    "test": "projen test",
    "test:watch": "projen test:watch",
    "unbump": "projen unbump",
    "upgrade": "projen upgrade",
    "watch": "projen watch",
    "projen": "projen"
  },
  "author": {
    "name": "Momo Kornher",
    "url": "https://moritzkornher.de",
    "organization": false
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5",
    "@types/jest": "^30.0.0",
    "@types/node": "ts5.9",
    "aws-cdk-lib": "^2.268.0",
    "commit-and-tag-version": "^12",
    "constructs": "^10.0.0",
    "jest": "^30.5.1",
    "jest-junit": "^17",
    "mrpj": "^0.2.11",
    "projen": "^0.103.20",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "5.9.x"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.174.0"
  },
  "dependencies": {
    "@aws-cdk/toolkit-lib": "^1.40.1",
    "@inquirer/select": "^4.4.2",
    "ansi-colors": "^4.1.3",
    "cli-table3": "^0.6.5",
    "yocto-spinner": "^1.2.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "onFail": "ignore"
    }
  },
  "main": "./lib/main.js",
  "license": "MIT",
  "homepage": "https://github.com/mrgrain/cdk-updown",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.0",
  "jest": {
    "coverageProvider": "v8",
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)",
      "<rootDir>/@(projenrc)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(projenrc)/**/__tests__/**/*.ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "test/tsconfig.json"
        }
      ]
    }
  },
  "types": "./lib/main.d.ts",
  "exports": {
    ".": {
      "types": "./lib/main.d.ts",
      "default": "./lib/main.js"
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
